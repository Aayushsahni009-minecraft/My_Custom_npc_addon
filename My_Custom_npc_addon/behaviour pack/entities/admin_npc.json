{
  "format_version": "1.20.0",
  "minecraft:entity": {
    "description": {
      "identifier": "custom:admin_npc",
      "is_spawnable": true,
      "is_summonable": true,
      "is_experimental": false
    },
    "components": {
      "minecraft:type_family": { "family": [ "inanimate", "command_block" ] },
      "minecraft:health": { "value": 99999, "max": 99999 },
      "minecraft:damage_sensor": {
        "triggers": {
          "cause": "all",
          "deals_damage": false
        }
      },
      "minecraft:physics": {},
      "minecraft:collision_box": { "width": 0.6, "height": 1.9 },
      "minecraft:nameable": { "always_show": true },
      "minecraft:interact": {
        "interactions": [
          {
            "on_interact": {
              "event": "custom:open_admin_gui"
            }
          }
        ]
      }
    },
    "events": {
      "custom:open_admin_gui": {
        "queue_command": {
          "command": [
            "scriptevent custom:admin_gui"
          ]
        }
      }
    }
  }
}